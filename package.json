{
  "name": "oui-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "OUI: the open contract for agent-controllable user interfaces. The oui-spec runtime, the @ouispec contract, generator and conformance kit, and the @ouispec agent SDK.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wesreid/oui.git"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "turbo run test",
    "test:ci": "turbo run test --concurrency=2",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release:check": "node scripts/release-check.mjs",
    "packs:check": "node scripts/verify-packs.mjs",
    "site": "node scripts/build-site.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "marked": "^16.0.0",
    "prettier": "^3.9.6",
    "turbo": "^2.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "packages/oui-spec/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "packages/*/src/**/*.{ts,tsx}": [
      "eslint --max-warnings 0"
    ],
    "packages/oui-spec/**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
