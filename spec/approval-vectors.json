{
  "version": 1,
  "algorithm": "SHA-256 over the RFC 8785 (JCS) canonical JSON of the value, UTF-8 encoded; lowercase hex",
  "use": "The approval args hash. Every implementation (an agent runtime, an approval store, the browser runtime, a gateway in another language) parses each `json`, canonicalizes it to exactly `canonical`, and hashes it to exactly `sha256`; it refuses every `invalid` input.",
  "provenance": "Canonical forms derived by hand from RFC 8785 §3.2 and Appendix B; hashes computed with Python hashlib over those forms, independently of any implementation under test.",
  "vectors": [
    {
      "name": "key order",
      "json": "{\"b\":2,\"a\":1,\"c\":{\"z\":true,\"y\":null,\"x\":[3,2,1]}}",
      "canonical": "{\"a\":1,\"b\":2,\"c\":{\"x\":[3,2,1],\"y\":null,\"z\":true}}",
      "sha256": "a3e834099e840d9028fa0c005d117ffd5ae99f8275223ae3b64121241290958d"
    },
    {
      "name": "key order by UTF-16 code units, not code points (RFC 8785 §3.2.3)",
      "json": "{\"\\u20ac\":\"Euro Sign\",\"\\r\":\"Carriage Return\",\"\\ufb33\":\"Hebrew Letter Dalet With Dagesh\",\"1\":\"One\",\"\\ud83d\\ude00\":\"Emoji: Grinning Face\",\"\\u0080\":\"Control\",\"\\u00f6\":\"Latin Small Letter O With Diaeresis\"}",
