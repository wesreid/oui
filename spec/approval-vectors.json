      "canonical": "{\"10\":6,\"9\":7,\"A\":4,\"_\":5,\"a\":2,\"aa\":1,\"b\":3}",
      "sha256": "e395d6cbc8557fd7b4e4dd42af7c48c30fb4d5ec7da43567ccf39bc322ff9804"
